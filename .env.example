# Required for account API
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Generate a random secret with at least 32 characters; keep it private.
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Comma-separated exact frontend origins allowed to open cross-origin Socket.IO connections.
APP_ORIGINS=https://your-iufye-domain.example

# Email OTP delivery (Resend)
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=IUFYE <verify@your-verified-domain.example>

# Phone OTP delivery (Twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-me
TWILIO_FROM=+15005550006

# Private file storage (Supabase Storage)
# Create a PRIVATE bucket named iufye-attachments in Supabase Storage.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=iufye-attachments
